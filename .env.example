# Application Settings
PROJECT_NAME="English for Kids API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL)
# Local: postgresql://kids_user:kids_password_123@localhost:5432/english_kids_db
# Docker Compose: postgresql://kids_user:kids_password_123@postgres_db:5432/english_kids_db
DATABASE_URL=postgresql://kids_user:kids_password_123@localhost:5432/english_kids_db

# Postgres Credentials (used by Docker Compose)
POSTGRES_USER=kids_user
POSTGRES_PASSWORD=kids_password_123
POSTGRES_DB=english_kids_db
POSTGRES_PORT=5432
REDIS_PORT=6380

# Security & JWT Configuration
# IMPORTANT: In production, generate a strong secret key (e.g. `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (JSON array or comma-separated list of origins)
BACKEND_CORS_ORIGINS=["*"]

# TTS / Audio Configuration
AUDIO_CACHE_DIR=static/audio
DEFAULT_TTS_VOICE=en-US-AnaNeural
